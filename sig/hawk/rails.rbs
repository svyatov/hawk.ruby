module Hawk
  interface _RailsErrorReporter
    def subscribe: (Hawk::Rails::ErrorSubscriber) -> void
  end
  interface _RailsMiddlewareStack
    def insert_after: (Class, Class, ?integration: Symbol) -> void
  end

  interface _RailsConfiguration
    def filter_parameters: () -> Array[top]
  end

  interface _RailsApplication
    def config: () -> _RailsConfiguration
    def middleware: () -> _RailsMiddlewareStack
  end

  module Rails
    def self.configure: (Configuration) -> void
    def self.activate_integrations: (Configuration) -> void
  end

  class Railtie
  end
end
