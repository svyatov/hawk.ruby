module Hawk
  interface _Delivery
    def enqueue: (String, String) -> bool
    def flush: (timeout: Float) -> bool
    def close: (timeout: Float) -> bool
  end

  class Client
    @delivery: _Delivery
    @store: ScopeStore
    @closed: bool
    attr_reader configuration: Configuration
    attr_reader diagnostics: Diagnostics
    def initialize: (Configuration, delivery: _Delivery) -> void
    def current_scope: () -> Scope
    def set_context: (raw_context) -> void
    def set_user: (raw_context?) -> void
    def with_scope: [A] () { (Scope) -> A } -> A
    def with_boundary: [A] (kind: Symbol, metadata: payload, ?inherit: bool) { () -> A } -> A
    def capture_exception: (Exception, ?context: raw_context, ?user: raw_context?, ?level: Symbol) -> String?
    def capture_message: (String, ?context: raw_context, ?user: raw_context?, ?level: Symbol) -> String?
    def capture: [A] () { () -> A } -> A
    def report: (Exception, mechanism: String, ?context: payload, ?level: Symbol, ?handled: bool) -> String?
    def remember_escape: (Exception) -> void
    def consume_escape: (Exception) -> bool
    def flush: (?timeout: Float) -> bool
    def close: (?timeout: Float) -> bool

    private

    def boundary_scope: (Scope, Symbol, payload, bool) -> Scope
    def dispatch: (?exception: Exception?, ?message: String?, ?context: raw_context, ?user: raw_context?, ?level: Symbol, ?addons: payload) -> String?
    def eligible?: (Exception?) -> bool
    def event_user: (raw_context?, Scope) -> payload
    def normal_termination?: (Exception) -> bool
  end
end
